# AirMe — frontend environment variables
# Copy to .env.local and fill in. Only VITE_* vars are exposed to the browser.

# Supabase project (Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay (public key id only — the secret lives in Supabase Edge Function env)
VITE_RAZORPAY_KEY_ID=

# Set to "true" to bypass the real gateway and instantly "capture" payments (UI demos)
VITE_PAYMENTS_MOCK=true

# --- Server-side only (DO NOT prefix with VITE_; set via `supabase secrets set`) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
